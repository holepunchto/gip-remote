{
  "name": "gip-remote",
  "version": "2.2.0",
  "description": "Git+Pear remote DB for handling git data",
  "main": "index.js",
  "scripts": {
    "build": "node build.js && prettier schema --write",
    "format": "prettier . --write",
    "test": "brittle-bare test/all.js",
    "lint": "prettier . --check && lunte"
  },
  "type": "commonjs",
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "zlib": {
      "bare": "bare-zlib",
      "default": "zlib"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "crypto": {
      "bare": "bare-crypto",
      "default": "crypto"
    },
    "child_process": {
      "bare": "bare-subprocess",
      "default": "child_process"
    }
  },
  "exports": {
    "./package": "./package.json",
    ".": {
      "default": "./index.js"
    },
    "./git": {
      "default": "./lib/git.js"
    },
    "./schema/hyperdb": {
      "default": "./schema/hyperdb/index.js"
    },
    "./schema/hyperschema": {
      "default": "./schema/hyperschema/index.js"
    }
  },
  "files": [
    "package.json",
    "index.js",
    "index.d.ts",
    "lib",
    "schema"
  ],
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/gip-remote.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/gip-remote/issues"
  },
  "homepage": "https://github.com/holepunchto/gip-remote",
  "devDependencies": {
    "bare-env": "^3.0.1",
    "bare-subprocess": "^6.1.0",
    "brittle": "^4.1.0",
    "corestore": "^7.11.1",
    "hyperdht": "^6.33.0",
    "hyperswarm": "^4.17.0",
    "lunte": "^1.8.4",
    "prettier": "^3.9.6",
    "prettier-config-holepunch": "^2.0.0",
    "test-tmp": "^1.4.0",
    "z32": "^1.1.0"
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "bare-crypto": "^1.15.3",
    "bare-fs": "^4.7.4",
    "bare-path": "^3.1.1",
    "bare-zlib": "^1.4.1",
    "hyperbee2": "^2.10.3",
    "hyperdb": "^6.7.0",
    "mirror-drive": "^1.14.2",
    "pear-link": "^5.0.0",
    "ready-resource": "^1.2.0",
    "scope-lock": "^1.2.4",
    "streamx": "^2.28.0"
  }
}
